# 取得した通知の実データ。実際のメッセージ本文・送信者名・社内パスが入るため
# 絶対にコミットしない。
phase1/data/
phase2/data/

# ワーカーが作った成果物 (業務内容そのものが入る)
phase4/output/

# Start.ps1 が回す3プロセスのログと pid 記録。
# メール本文や Slack の内容がそのまま流れるのでコミットしない。
logs/

# 資格情報 (DPAPI暗号化済みだが置く必要なし)
phase5/data/
**/notifications.jsonl
**/state.json

# 資格情報
*.env
.env*
secrets.json
token*.json
# OAuth クライアント (Google Cloud からダウンロードした素のまま)。
# Connect-Service.ps1 で DPAPI に取り込んだ後はリポジトリに置く必要がない。
client_secret*.json

# Windows / エディタ
Thumbs.db
desktop.ini
.vscode/
.idea/

# 配布設定。配る人が用意した資格情報 (Google の OAuth クライアント、API キー) が
# 平文で入るのでコミットしない。見本は config/app-config.sample.json。
config/app-config.json
